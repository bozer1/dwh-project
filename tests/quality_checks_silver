--data quality :PK unique ve not null olmalı

SELECT 
cst_id,
COUNT(*) tekrar
FROM bronze.crm_cust_info
GROUP BY cst_id 
HAVING COUNT(*)>1 --OR cst_id IS NULL



--flag_last: ROW_NUMBER() fonksiyonu her bir satıra tanımlanan gruplandırmaya 
--ve sıraya göre unique number atar.aynı grup içinde creation datei en son olan 1 numara olmak üzere gruplandırılr.
--çünkü ROW_NUMBER() fonk öyle tanımladık
--Biz de ROW_NUMBER() fonksiyonunun unique number atamasından where flag_last=1 diyerek faydalanırız.
--böylelikle de duplicate olanları elemiş oluruz


---------------------------------
SELECT * FROM bronze.crm_cust_info
---------------------------------
SELECT 
      cst_id,
      cst_key,
      TRIM(cst_firstname),
      TRIM(cst_lastname),
      cst_material_status,
      cst_gndr,
      cst_create_date FROM 
( 

SELECT 
*,
ROW_NUMBER() OVER(PARTITION BY cst_id ORDER BY cst_create_date DESC) AS flag_last
FROM bronze.crm_cust_info 
WHERE cst_id IS NOT NULL

)t WHERE flag_last =1 




